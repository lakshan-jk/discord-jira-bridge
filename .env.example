# Copy to .env and fill in. Validated by zod on startup (src/config) — the process
# refuses to start if anything here is missing or malformed.
#
# The placeholders below are deliberately VALID IN FORMAT (a real URL, a real email,
# non-empty tokens), so the service boots and /health works WITHOUT real JIRA or
# Discord accounts. Discord simply fails to connect and ingestion is disabled; the
# DB, /health endpoint, and worker still run. Replace the JIRA/Discord values with
# real secrets when you want actual syncing.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- PostgreSQL (defaults match docker-compose.yml) ---
DATABASE_URL=postgres://jumeau:jumeau@localhost:5432/jumeau

# --- JIRA Cloud service account (placeholder — replace to enable syncing) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=service-account@your-org.com
JIRA_API_TOKEN=replace-with-atlassian-api-token

# --- Discord bot (placeholder — replace to enable ingestion) ---
DISCORD_BOT_TOKEN=replace-with-discord-bot-token

# --- Historical backfill (design #7) ---
# Hours to look back on startup; keep small to avoid a flood of JIRA writes.
BACKFILL_LOOKBACK_HOURS=24
# Whether the startup backfill also scans archived forum threads ("true"/"false").
BACKFILL_INCLUDE_ARCHIVED=false
